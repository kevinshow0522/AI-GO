<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>AISwitchDesk</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net40</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>5</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="chatgpt.png" />
    <None Remove="claude-mark.png" />
    <None Remove="compare-mark.png" />
    <None Remove="desk-mark.png" />
    <None Remove="Settings.xaml" />
    <None Remove="ExitMenu.xaml" />
    <EmbeddedResource Include="chatgpt.png" LogicalName="chatgpt.png" />
    <EmbeddedResource Include="claude-mark.png" LogicalName="claude-mark.png" />
    <EmbeddedResource Include="compare-mark.png" LogicalName="compare-mark.png" />
    <EmbeddedResource Include="desk-mark.png" LogicalName="desk-mark.png" />
    <EmbeddedResource Include="Settings.xaml" LogicalName="Settings.xaml" />
    <EmbeddedResource Include="ExitMenu.xaml" LogicalName="ExitMenu.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Windows.Graphics">
      <HintPath>..\..\..\..\..\..\..\..\..\WINDOWS\system32\WinMetadata\Windows.Graphics.winmd</HintPath>
    </Reference>
    <Reference Include="System.Core" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="PresentationCore" />
    <Reference Include="Windows.UI">
      <HintPath>..\..\..\..\..\..\..\..\..\WINDOWS\system32\WinMetadata\Windows.UI.winmd</HintPath>
    </Reference>
    <Reference Include="System.Management" />
    <Reference Include="WindowsBase" />
    <Reference Include="WindowsFormsIntegration" />
    <Reference Include="Windows.System">
      <HintPath>..\..\..\..\..\..\..\..\..\WINDOWS\system32\WinMetadata\Windows.System.winmd</HintPath>
    </Reference>
    <Reference Include="System.Numerics" />
    <Reference Include="Windows.Foundation">
      <HintPath>..\..\..\..\..\..\..\..\..\WINDOWS\system32\WinMetadata\Windows.Foundation.winmd</HintPath>
    </Reference>
  </ItemGroup>
</Project>
