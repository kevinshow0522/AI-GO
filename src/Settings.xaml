<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AI 双窗 · 设置" Width="456" Height="384" WindowStartupLocation="Manual"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Background="Transparent"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI" FontSize="13"
        Foreground="{DynamicResource ThemeInk}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="17" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="Control">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
        <Border IsHitTestVisible="False" Margin="1" CornerRadius="6" BorderThickness="1.5"
                BorderBrush="{DynamicResource ThemeAccentLine}" SnapsToDevicePixels="True"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsControl" TargetType="Control">
      <Setter Property="FocusVisualStyle" Value="{StaticResource {x:Static SystemParameters.FocusVisualStyleKey}}"/>
    </Style>
    <Style TargetType="ListBox" BasedOn="{StaticResource SettingsControl}"/>
    <Style TargetType="ScrollViewer" BasedOn="{StaticResource SettingsControl}"/>
    <Style x:Key="CloseFocus" TargetType="Control">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
        <Border IsHitTestVisible="False" Width="12" Height="2" Margin="0,0,0,3" CornerRadius="1"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{DynamicResource ThemeAccentLine}"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeRule}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9,5"><ContentPresenter/></Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource SettingsControl}">
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="10,6"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="box" Background="{TemplateBinding Background}" CornerRadius="12"
                BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
          <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="box" Property="Background" Value="{DynamicResource ThemeSelected}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="box" Property="Opacity" Value=".38"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource Quiet}">
      <Setter Property="Background" Value="{DynamicResource ThemeControl}"/><Setter Property="Padding" Value="13,5"/>
    </Style>
    <Style x:Key="Tab" TargetType="RadioButton" BasedOn="{StaticResource SettingsControl}">
      <Setter Property="Foreground" Value="{DynamicResource ThemeMuted}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Grid Background="Transparent">
          <ContentPresenter VerticalAlignment="Center" Margin="3,0,3,3"/>
          <Border x:Name="indicator" Height="2" CornerRadius="1" VerticalAlignment="Bottom" Background="Transparent"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/><Setter TargetName="indicator" Property="Background" Value="{DynamicResource ThemeAccentLine}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ThemeMuted}"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Percent" TargetType="RadioButton" BasedOn="{StaticResource SettingsControl}">
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="2,0,0,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border Name="pill" Padding="8,4" CornerRadius="8" Background="Transparent">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="pill" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="pill" Property="Background" Value="{DynamicResource ThemeSelected}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox" BasedOn="{StaticResource SettingsControl}">
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent">
          <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
          <Border x:Name="track" Width="34" Height="20" CornerRadius="10" Background="{DynamicResource ThemeMuted}" HorizontalAlignment="Right">
            <Ellipse x:Name="thumb" Margin="3" Width="14" Height="14" Fill="{DynamicResource ThemeOnAccent}" HorizontalAlignment="Left"/>
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="track" Property="Background" Value="{DynamicResource ThemeAccent}"/><Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="track" Property="Opacity" Value=".78"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource SettingsControl}">
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="row" Background="Transparent" Padding="9,7" CornerRadius="9"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource ThemeSelected}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SkinChoice" TargetType="RadioButton" BasedOn="{StaticResource SettingsControl}">
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="3,2"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border Name="tile" Height="39" CornerRadius="9" Padding="9,3" Background="{DynamicResource ThemeControl}"
                BorderBrush="{DynamicResource ThemeRule}" BorderThickness="1">
          <Grid>
            <ContentPresenter VerticalAlignment="Center" Margin="0,0,21,0"/>
            <Border Name="tick" Width="17" Height="17" HorizontalAlignment="Right" VerticalAlignment="Center"
                    CornerRadius="9" Background="{DynamicResource ThemeAccent}" Visibility="Hidden">
              <Path Data="M 3,7 L 6,10 L 12,4" Width="13" Height="13" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Stroke="{DynamicResource ThemeOnAccent}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Border>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="tile" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="tile" Property="Background" Value="{DynamicResource ThemeSelected}"/>
            <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource ThemeAccentLine}"/>
            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AccentChoice" TargetType="RadioButton" BasedOn="{StaticResource SettingsControl}">
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="2,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="chip" Height="30" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource ThemeControl}" BorderBrush="{DynamicResource ThemeRule}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Width="15" Height="15" Margin="0,0,5,0">
              <Ellipse Fill="{TemplateBinding Background}"/>
              <Path x:Name="tick" Visibility="Hidden" Data="M 3.5,7.5 L 6.3,10.1 L 11.5,4.7"
                    Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Grid>
            <ContentPresenter VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="chip" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="chip" Property="Background" Value="{DynamicResource ThemeSelected}"/>
            <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource ThemeAccentLine}"/>
            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border Name="Surface" CornerRadius="17" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeRule}" BorderThickness="1">
    <Grid Margin="22,15,22,13">
      <Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="37"/><RowDefinition Height="*"/><RowDefinition Height="41"/></Grid.RowDefinitions>
      <Grid Name="DragBar" Background="Transparent">
        <TextBlock Text="设置" FontWeight="SemiBold" FontSize="21" VerticalAlignment="Center"/>
        <Button Name="CloseTop" AutomationProperties.Name="关闭设置" ToolTip="关闭" Cursor="Hand"
                Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" FocusVisualStyle="{StaticResource CloseFocus}">
          <Button.Template><ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="shade" Background="Transparent" CornerRadius="7" IsHitTestVisible="False"/>
              <Path x:Name="glyph" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="M 2,2 L 12,12 M 12,2 L 2,12" Stretch="None" Stroke="{DynamicResource ThemeMuted}"
                    StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    IsHitTestVisible="False" SnapsToDevicePixels="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="shade" Property="Background" Value="{DynamicResource ThemeHover}"/>
                <Setter TargetName="glyph" Property="Stroke" Value="{DynamicResource ThemeInk}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="shade" Property="Background" Value="{DynamicResource ThemeSelected}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Button.Template>
        </Button>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="4" Height="1" Background="{DynamicResource ThemeRule}" VerticalAlignment="Bottom"/>
        <RadioButton Name="UseTab" GroupName="Pages" Style="{StaticResource Tab}" Content="套餐用量" Margin="0,0,22,0"/>
        <RadioButton Name="LogTab" Grid.Column="1" GroupName="Pages" Style="{StaticResource Tab}" Content="自动转发" Margin="0,0,22,0"/>
        <RadioButton Name="QueueTab" Grid.Column="2" GroupName="Pages" Style="{StaticResource Tab}" Content="文件队列"/>
        <RadioButton Name="AppearanceTab" Grid.Column="3" HorizontalAlignment="Right" GroupName="Pages"
                     Style="{StaticResource Tab}" Content="外观" IsChecked="True"/>
      </Grid>
      <Grid Grid.Row="2" Margin="0,12,0,7">
        <Grid Name="AppearancePage">
          <StackPanel>
            <Grid Margin="0,0,0,3">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Text="浅色主题" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="1" Text="深色主题" FontWeight="SemiBold" Margin="3,0,0,0"/>
            </Grid>
            <UniformGrid Name="ThemeChoices" Rows="3" Columns="2" Margin="-3,0,-3,0"
                         AutomationProperties.Name="主题" KeyboardNavigation.DirectionalNavigation="Contained"/>
            <Grid Margin="0,7,0,3" Height="24">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="强调色" FontWeight="SemiBold"/>
                <TextBlock Name="AccentValue" Margin="9,0,0,0" Style="{StaticResource Caption}"/>
              </StackPanel>
              <Button Name="OriginalAccent" HorizontalAlignment="Right" Content="恢复主题原色"
                      FontSize="12" Padding="6,1" Style="{StaticResource Quiet}"/>
            </Grid>
            <UniformGrid Name="AccentChoices" Rows="1" Columns="6" Margin="-2,0,-2,0"
                         AutomationProperties.Name="强调色" KeyboardNavigation.DirectionalNavigation="Contained"/>
          </StackPanel>
        </Grid>
        <Grid Name="UsePage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="35"/><RowDefinition Height="36"/></Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
            <StackPanel>
              <StackPanel Name="GptCard" Margin="1,1,0,10"/>
              <Border Height="1" Background="{DynamicResource ThemeRule}"/>
              <StackPanel Name="ClaudeCard" Margin="1,11,0,7"/>
            </StackPanel>
          </ScrollViewer>
          <DockPanel Grid.Row="1" LastChildFill="False" VerticalAlignment="Center" ToolTip="余额低于所选比例时，用量环变为琥珀色">
            <TextBlock Text="低量提醒" Style="{StaticResource Caption}" Margin="1,0,10,0"/>
            <RadioButton Name="Alert0" GroupName="Threshold" Style="{StaticResource Percent}" Content="关闭"/>
            <RadioButton Name="Alert10" GroupName="Threshold" Style="{StaticResource Percent}" Content="10%"/>
            <RadioButton Name="Alert20" GroupName="Threshold" Style="{StaticResource Percent}" Content="20%"/>
            <RadioButton Name="Alert30" GroupName="Threshold" Style="{StaticResource Percent}" Content="30%"/>
          </DockPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button Name="Refresh" Style="{StaticResource Action}" Content="刷新额度"/>
            <Button Name="OfficialPage" Margin="5,0,0,0" Style="{StaticResource Quiet}" Content="Claude 用量页 ↗"/>
          </StackPanel>
        </Grid>
        <Grid Name="QueuePage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition/></Grid.RowDefinitions>
          <DockPanel LastChildFill="True">
            <Button Name="ClearUploads" DockPanel.Dock="Right" Content="清除已结束" Style="{StaticResource Quiet}" Padding="7,2"/>
            <TextBlock Name="UploadSummary" VerticalAlignment="Center" FontWeight="SemiBold"/>
          </DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Name="UploadList" AutomationProperties.Name="文件投递记录">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border Margin="0,0,2,5" Padding="9,6" CornerRadius="8" Background="{DynamicResource ThemeControl}" ToolTip="{Binding Description}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" Content="重试" Tag="{Binding}"
                            AutomationProperties.Name="{Binding Name, StringFormat='重试 {0}'}">
                      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Action}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding CanRetry}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                      </Style></Button.Style>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
        <Grid Name="LogPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="57"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="36"/></Grid.RowDefinitions>
          <StackPanel>
            <CheckBox Name="AutoSend" Style="{StaticResource Switch}" Content="后台文件接力" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="在 GPT 中说「交给 Claude 修改，改完发回这里」。"/>
          </StackPanel>
          <ListBox Name="LogList" Grid.Row="1" AutomationProperties.Name="交接列表" Background="Transparent" Foreground="{DynamicResource ThemeInk}"
                   BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
          <TextBlock Name="LogDetail" Grid.Row="2" TextWrapping="Wrap" MaxHeight="62" Margin="1,8,0,3" Style="{StaticResource Caption}"/>
          <DockPanel Grid.Row="3" LastChildFill="False" VerticalAlignment="Bottom">
            <Button Name="Reload" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Content="刷新"/>
            <Button Name="Resume" Style="{StaticResource Action}" Content="继续核对"/>
            <Button Name="Files" Style="{StaticResource Quiet}" Content="文件夹 ↗"/>
            <Button Name="CancelJob" Style="{StaticResource Quiet}" Content="取消交接"/>
          </DockPanel>
        </Grid>
      </Grid>
      <Grid Grid.Row="3">
        <Border Height="1" Background="{DynamicResource ThemeRule}" VerticalAlignment="Top"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
          <TextBlock Text="侧栏大小" Style="{StaticResource Caption}" Margin="1,0,9,0"/>
          <Button Name="Smaller" AutomationProperties.Name="缩小侧栏" Style="{StaticResource Quiet}" Content="−" Width="27" Height="26" Padding="2"/>
          <TextBlock Name="ScaleValue" Width="39" TextAlignment="Center" VerticalAlignment="Center"/>
          <Button Name="Larger" AutomationProperties.Name="放大侧栏" Style="{StaticResource Quiet}" Content="+" Width="27" Height="26" Padding="2"/>
        </StackPanel>
        <Button Name="Compare" Style="{StaticResource Quiet}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Padding="5,1" ToolTip="在侧栏也可并排或还原窗口" AutomationProperties.Name="{Binding Text, ElementName=CompareLabel}">
          <StackPanel Orientation="Horizontal">
            <Border Name="CompareGlyph" Width="24" Height="24" VerticalAlignment="Center"
                    IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality">
              <Viewbox><Canvas Width="36" Height="36">
                <Border Name="CompareUpper" Canvas.Left="2" Canvas.Top="2" Width="32" Height="32" Background="{DynamicResource ThemeInk}">
                  <Border.Clip><PathGeometry Figures="M0,0 L32,0 0,32 Z"/></Border.Clip>
                  <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                </Border>
                <Border Name="CompareLower" Canvas.Left="2" Canvas.Top="2" Width="32" Height="32" Background="{DynamicResource ThemeInk}">
                  <Border.Clip><PathGeometry Figures="M32,0 L32,32 0,32 Z"/></Border.Clip>
                  <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                </Border>
                <Line Name="CompareSlash" Stroke="{DynamicResource ThemeAccentLine}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Canvas></Viewbox>
            </Border>
            <TextBlock Name="CompareLabel" Text="并排对照" Margin="5,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Name="ExitRail" Style="{StaticResource Quiet}" Content="退出侧栏" Padding="5,3" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
      </Grid>
    </Grid>
  </Border>
</Window>
